# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- WhatsApp bot (/api/whatsapp/webhook) — SERVER-ONLY secrets. ---
# Never expose any of these with a NEXT_PUBLIC_ prefix.

# Supabase service-role key (Project Settings → API). Bypasses RLS so the
# webhook can write leads and chat transcripts without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the Claude-powered agent (read by the SDK).
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API (Meta for Developers → your app → WhatsApp):
# permanent system-user access token, the sender's phone-number id, the
# app secret (used to verify webhook signatures), and a verify token you
# invent and paste into the webhook setup screen.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
