# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Social publishing module (/social) — server-side only, never NEXT_PUBLIC_ ---
# Meta app (developers.facebook.com → My Apps → Settings → Basic).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: pin the Graph API version (default v24.0) and the exact OAuth
# redirect URI whitelisted in the Meta app (default: derived from the request
# host, i.e. https://<your-domain>/api/social/facebook/callback).
# FACEBOOK_GRAPH_VERSION=v24.0
# FACEBOOK_REDIRECT_URI=https://your-domain/api/social/facebook/callback
# Supabase service-role key (Project Settings → API). Lets the server read the
# encrypted tokens table that no browser session can read.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string (32+ chars). Encrypts every Meta token at rest.
SOCIAL_ENCRYPTION_KEY=
# Shared secret the scheduled worker presents (GitHub Actions / Vercel Cron).
SOCIAL_CRON_SECRET=

# --- Local browser worker for Facebook GROUPS (runs on your computer) -------
# `npm run social-worker` signs in to Supabase as the admin user (the same
# login you use for /crm and /social) — this is NOT your Facebook password.
# Facebook login happens in the real Chrome window the worker opens.
SOCIAL_WORKER_EMAIL=
SOCIAL_WORKER_PASSWORD=
# Optional: a label for this machine in the dashboard.
# SOCIAL_WORKER_NAME=laptop
# Optional: where the logged-in Chrome profile lives (default ~/.hapitaron-social/facebook-profile).
# SOCIAL_BROWSER_PROFILE_DIR=
# Optional: chrome (default, uses your installed Google Chrome) | msedge | chromium
# SOCIAL_BROWSER_CHANNEL=chrome
# Optional: explicit browser binary instead of a channel.
# SOCIAL_BROWSER_EXECUTABLE=
# Optional: force a visible window regardless of the dashboard's Debug Mode.
# SOCIAL_BROWSER_HEADED=1
