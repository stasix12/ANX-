# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Automatic day trading (/trading) ────────────────────────────────────────
# API keys from https://app.alpaca.markets (create them under the PAPER
# account). These are server-side secrets — never expose them with a
# NEXT_PUBLIC_ prefix.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Paper (simulated money) is the default. To trade REAL money you must set
# BOTH of the following — either one alone is refused by the engine:
#   ALPACA_PAPER=false
#   ALPACA_ALLOW_LIVE=I_UNDERSTAND_THE_RISKS

# Bearer token that protects /api/trading/* and the /trading dashboard.
# Optional while in paper mode, REQUIRED for live trading. On Vercel the
# CRON_SECRET env var works the same way (Vercel's cron sends it itself).
TRADING_API_SECRET=

# Strategy tuning (all optional; defaults shown):
# TRADING_ENABLED=true              # false = engine off, dashboard still works
# TRADING_MAX_POSITIONS=3
# TRADING_POSITION_PCT=0.1          # fraction of equity per position
# TRADING_MAX_POSITION_USD=2000
# TRADING_TAKE_PROFIT_PCT=0.04
# TRADING_STOP_LOSS_PCT=0.02
# TRADING_MAX_DAILY_LOSS_PCT=0.03   # circuit breaker: halt + liquidate
# TRADING_MIN_PRICE=3
# TRADING_MAX_PRICE=100
# TRADING_MIN_DAY_CHANGE_PCT=3
# TRADING_MIN_DOLLAR_VOLUME=5000000
# TRADING_ENTRY_START_ET=09:40      # US Eastern time
# TRADING_ENTRY_END_ET=15:00
# TRADING_LIQUIDATE_ET=15:50
