# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- AdSignal
# Server-only Supabase key (Project Settings → API → service_role). Required
# for AdSignal: all adsignal_* tables are RLS-locked and only the server may
# touch them. NEVER expose this in the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Meta Ad Library API (https://www.facebook.com/ads/library/api) — requires
# Meta developer identity verification. Covers ALL EU ads + political ads
# worldwide (incl. IL). Commercial IL-only ads are NOT in the API.
META_ADLIB_ACCESS_TOKEN=
# Countries to scan, comma-separated ISO codes. IL = political ads only;
# add EU codes (e.g. IL,NL,DE) for full commercial coverage there.
ADSIGNAL_META_COUNTRIES=IL,NL

# YouTube Data API v3 key (Google Cloud Console) — organic niche signal.
YOUTUBE_API_KEY=

# SerpApi key (https://serpapi.com) — Google Trends interest series for IL.
SERPAPI_KEY=
# Optional: limit trends fetching to a subset of niche keys to save quota,
# e.g. sofa_cleaning,hvac,solar
ADSIGNAL_TRENDS_NICHES=

# Anthropic API key — powers "Analyze with AI" (labeled AI_ESTIMATE).
ANTHROPIC_API_KEY=

# Optional: when set, /api/adsignal/sync requires "Authorization: Bearer <this>".
# Vercel sets CRON_SECRET automatically for cron calls — use the same value.
ADSIGNAL_CRON_SECRET=
