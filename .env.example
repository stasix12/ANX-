# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── LeadCloser AI (/lc) ────────────────────────────────────────────────────
# Server-only. Lets /api/lc/intake write leads for any organisation after
# validating the org's intake token. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. When set, the agent's wording is rephrased by Claude (the pricing,
# slot and booking decisions stay deterministic). Leave empty for the mock.
ANTHROPIC_API_KEY=
# WhatsApp Cloud API (Meta). The verify token is any secret string you choose —
# paste the same value in the Meta app's webhook configuration. The app secret
# (Meta app → Settings → Basic) lets the webhook validate request signatures.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
