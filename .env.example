# Copy to .env.local for local development.
# Both values live under Project Settings → API in the Supabase dashboard.
# The anon/publishable key is meant to be public — it is safe to commit or
# share; access is enforced by the RLS policies in supabase/schema.sql, not
# by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# SEO system (/crm/seo + /api/seo/*) — see docs/SEO.md
# ─────────────────────────────────────────────────────────────────────────────
#
# EVERY value below is server-only. None is prefixed NEXT_PUBLIC_, so none is
# bundled into the browser. Set them in the host's environment settings (Vercel:
# Project → Settings → Environment Variables), never in a committed file.
#
# The site builds and runs without any of them: the SEO dashboard reports each
# integration as "not connected" and names the variables it needs, which is
# exactly what it is supposed to do rather than showing zeros.

# Supabase service role. Lets the scheduled cycle write articles with no signed-in
# user. This key bypasses Row Level Security — treat it like a database password
# and never expose it to the browser.
# Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the article writer. Used only inside /api/seo/*.
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Shared secret the weekly scheduler presents to POST /api/seo/run.
# Generate one with:  openssl rand -hex 32
# Must match the SEO_CRON_SECRET repository secret used by
# .github/workflows/seo-weekly.yml. If unset, the cron path is closed — the
# endpoint then only accepts a signed-in admin.
CRON_SECRET=

# Google Search Console. Without these the performance and keyword screens show
# "not connected" and the weekly cycle picks subjects from its seed backlog
# instead of from real search demand.
#
# The property exactly as Search Console spells it, including the trailing
# slash, or sc-domain:example.co.il for a domain property.
GSC_SITE_URL=
# An OAuth client of type "Web application" in Google Cloud Console, with the
# Search Console API enabled, plus a refresh token for an account that can read
# the property. Scope: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
