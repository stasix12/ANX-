/.social-profile/
/worker/.profile/
*.storage-state.json
/worker/screenshots/

# local dev server output
dev.log

# The packaged desktop app. Built by scripts/build-app.mjs and
# electron-builder; hundreds of megabytes, and rebuilt from source every time.
/dist

# פרטי כניסה של לקוחות ל-workers בענן — סודות, לעולם לא לריפו.
worker/customers/*.env

# Throwaway browser fixtures. A measured test has to live under worker/test/
# to resolve playwright-core and the '@/...' alias, so an investigation that
# needs to mount a component writes one here and deletes it afterwards — and
# twice now one has been left behind and swept into a commit. Anything a
# human wrote is named without the dot; this pattern is for the scratch only.
worker/test/.tmp-*
