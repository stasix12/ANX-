# ─────────────────────────────────────────────────────────────────────────
#  העתיקו ל-.env.local (פיתוח) או הגדירו בפלטפורמת האחסון (Vercel וכו').
#  כל הערכים ריקים בכוונה — האתר עובד גם בלעדיהם, אבל כפתורי WhatsApp/טלפון
#  והמעקב יופעלו רק אחרי שתמלאו אותם. אין כאן מזהים אמיתיים.
# ─────────────────────────────────────────────────────────────────────────

# כתובת האתר בפרודקשן (ללא סלאש בסוף). משמש ל-canonical, sitemap, OG.
# NEXT_PUBLIC_SITE_URL=https://example.co.il

# ── יצירת קשר ────────────────────────────────────────────────────────────
# מספר WhatsApp בפורמט בינלאומי, ללא + וללא רווחים. למשל: 972501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# מספר טלפון (אותו פורמט). ריק = קישורי טלפון לא מוצגים.
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── טופס לידים ──────────────────────────────────────────────────────────
# אם ריק: הטופס פותח WhatsApp עם הפרטים שמולאו (לא צריך שרת בכלל).
# אם מלא: הטופס שולח POST JSON { name, phone, business, interest, source, page }.
# אפשרויות ללא שרת: Formspree (https://formspree.io/f/xxxx), Web3Forms,
# Google Apps Script Web App, או Zapier/Make Webhook.
NEXT_PUBLIC_LEAD_ENDPOINT=
# Web3Forms בלבד: מפתח הגישה (נשלח בגוף הבקשה)
NEXT_PUBLIC_LEAD_ACCESS_KEY=

# ── Analytics / Tracking (כולם אופציונליים) ──────────────────────────────
# Google Tag Manager — GTM-XXXXXXX. מומלץ: כשהוא מוגדר, GA4 / Google Ads / Meta
# מנוהלים מתוך הקונטיינר, והמזהים הישירים למטה מתעלמים (מונע ספירה כפולה).
NEXT_PUBLIC_GTM_ID=
# GA4 ישיר (רק אם לא משתמשים ב-GTM) — G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Google Ads — AW-XXXXXXXXX + תווית המרה לליד (Conversion Label)
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_CONVERSION_LABEL=
# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# סביבת בדיקה/Preview: 1 = noindex + robots Disallow (ב-Vercel קורה אוטומטית מחוץ ל-production)
NEXT_PUBLIC_NOINDEX=
# אימות Search Console (התוכן של meta name="google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
