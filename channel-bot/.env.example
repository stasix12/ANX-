# Скопируйте в .env (или экспортируйте в окружение) и заполните.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Канал для публикаций: @username канала или числовой id (-100...)
TELEGRAM_CHANNEL_ID=@your_channel

# Ваш личный chat id с ботом (узнать: напишите боту /start и посмотрите логи,
# или спросите у @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Необязательные настройки
# FETCH_INTERVAL_MINUTES=30
# MAX_DRAFTS_PER_CYCLE=5
# ANTHROPIC_MODEL=claude-sonnet-5
