# לקוח אחד = קובץ אחד כזה. להעתיק ל-customer1.env (בלי .example) ולמלא.
#
# הקובץ הזה הוא סוד: יש בו את פרטי הכניסה של הלקוח לאפליקציה. He stays out
# of git (.gitignore covers worker/customers/*.env) and never leaves the
# server. The Facebook password is NOT here and is nowhere — Facebook sign-in
# happens in the browser profile, which travels via the dashboard upload card.

# הפרויקט — זהה לכל הלקוחות (אותו Supabase של המוצר):
NEXT_PUBLIC_SUPABASE_URL=https://atcsfvkulltkaadanplv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tOrSonGvYvbbhO7cvoZZlw_iV_YLOGE

# החשבון של הלקוח באפליקציה (מה שהוא נרשם איתו ב-/social/login).
# זה מה שתוחם את ה-worker לעסק שלו בלבד — אל תמחזרו חשבון בין לקוחות.
SOCIAL_WORKER_EMAIL=customer@example.com
SOCIAL_WORKER_PASSWORD=change-me

# השם שה-worker מופיע איתו בלוח הבקרה של הלקוח. אחד לכל לקוח.
SOCIAL_WORKER_NAME=worker@cloud-1

# פרוקסי ביתי — רק אם פייסבוק מתעקשת על אימות חוזר מהכתובת של השרת:
# SOCIAL_BROWSER_PROXY=http://proxy.example.com:8080
# SOCIAL_BROWSER_PROXY_USER=
# SOCIAL_BROWSER_PROXY_PASS=
